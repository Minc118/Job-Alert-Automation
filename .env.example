DATABASE_URL=

# Phase 2 placeholders only. Do not place real secrets in this example file.
GOOGLE_OAUTH_CLIENT_SECRETS_FILE=secrets/google_oauth_client.json
GOOGLE_TOKEN_MINJIAN=secrets/token_minjian.json
GOOGLE_TOKEN_CHANG=secrets/token_chang.json

# Local private profile files for manual Codex analysis requests.
PROFILE_MINJIAN_PATH=private/profiles/profile_minjian.md
PROFILE_CHANG_PATH=private/profiles/profile_chang.md

# Future backend-only Gemini analysis placeholders. Frontend code must not read these.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_ANALYSIS_MAX_JOBS=20
