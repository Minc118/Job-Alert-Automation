DATABASE_URL=

# Comma-separated browser origins allowed to call FastAPI with Authorization headers.
# Keep this explicit for each deployed frontend origin; do not use wildcard values.
API_CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Shared Google OAuth client configuration for Gmail flows.
GOOGLE_OAUTH_CLIENT_SECRETS_FILE=secrets/google_oauth_client.json

# Legacy fixed-user CLI token paths only.
# Web multi-user Gmail OAuth stores encrypted user credentials behind FastAPI.
GOOGLE_TOKEN_MINJIAN=secrets/token_minjian.json
GOOGLE_TOKEN_CHANG=secrets/token_chang.json

# Per-user web Gmail OAuth. Generate secure random values locally; do not commit them.
GMAIL_OAUTH_REDIRECT_URI=http://localhost:8000/api/gmail/callback
FRONTEND_BASE_URL=http://localhost:5173
GMAIL_OAUTH_STATE_SECRET=
GMAIL_TOKEN_ENCRYPTION_KEY=

# Local private profile files for manual Codex analysis requests.
PROFILE_MINJIAN_PATH=private/profiles/profile_minjian.md
PROFILE_CHANG_PATH=private/profiles/profile_chang.md

# Backend-only AI analysis. Frontend code must not read these.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_ANALYSIS_MAX_JOBS=20

# Frontend app authentication configuration for Docker Compose.
# VITE_NEON_AUTH_URL is the public Neon Auth URL, not DATABASE_URL.
VITE_AUTH_MODE=mock
VITE_NEON_AUTH_URL=

# Backend Neon Auth JWT verification. Copy the JWKS URL from Neon Auth configuration.
NEON_AUTH_JWKS_URL=
